<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@color/m3_surface">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_feature_btn"
                android:contentDescription="Back"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Theme &amp; Appearance"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Live Keyboard Mock Preview Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE PREVIEW"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <LinearLayout
                android:id="@+id/preview_keyboard_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/bg_suggestion_center">

                <!-- Mock Top Strip -->
                <LinearLayout
                    android:id="@+id/preview_top_strip"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="6dp"
                    android:background="@drawable/bg_top_strip">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Suggestions &amp; Features"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Mock Key Row 1 -->
                <LinearLayout
                    android:id="@+id/mock_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/pk_q"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="Q"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_suggestion_item" />
                    <TextView
                        android:id="@+id/pk_w"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="W"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_suggestion_item" />
                    <TextView
                        android:id="@+id/pk_e"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="E"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_suggestion_item" />
                    <TextView
                        android:id="@+id/pk_r"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="R"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_suggestion_item" />
                    <TextView
                        android:id="@+id/pk_t"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_suggestion_item" />
                    <TextView
                        android:id="@+id/pk_y"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="Y"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_suggestion_item" />
                </LinearLayout>

                <!-- Mock Key Row 2 -->
                <LinearLayout
                    android:id="@+id/mock_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/pk_shift"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="⇧"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:background="@drawable/bg_suggestion_item" />
                    <TextView
                        android:id="@+id/pk_space"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3.6"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="Space"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:background="@drawable/bg_suggestion_item" />
                    <TextView
                        android:id="@+id/pk_enter"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.4"
                        android:layout_margin="2dp"
                        android:gravity="center"
                        android:text="↵"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:background="@drawable/bg_category_badge" />
                </LinearLayout>
            </LinearLayout>

            <!-- Theme Presets Horizontal Carousel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="THEME PRESETS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_theme_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:clipToPadding="false" />

            <!-- Height Adjustment Slider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="KEYBOARD HEIGHT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_suggestion_center">

                <SeekBar
                    android:id="@+id/seek_keyboard_height"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="80"
                    android:progress="30" />

                <TextView
                    android:id="@+id/tv_height_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="100%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue" />
            </LinearLayout>

            <!-- Key Spacing Slider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="KEY SPACING / MARGINS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_suggestion_center">

                <SeekBar
                    android:id="@+id/seek_key_spacing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="9"
                    android:progress="2" />

                <TextView
                    android:id="@+id/tv_spacing_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="3 dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue" />
            </LinearLayout>

            <!-- Key Corner Radius Slider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="KEY CORNER RADIUS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_suggestion_center">

                <SeekBar
                    android:id="@+id/seek_key_radius"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="18"
                    android:progress="4" />

                <TextView
                    android:id="@+id/tv_radius_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="6 dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue" />
            </LinearLayout>

            <!-- Custom Wallpaper & Background Image Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CUSTOM WALLPAPER / BACKGROUND"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_suggestion_center">

                <Button
                    android:id="@+id/btn_pick_bg_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🖼️ Choose Background Image"
                    android:backgroundTint="@color/accent_purple" />

                <Button
                    android:id="@+id/btn_remove_bg_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🗑️ Remove Custom Image"
                    android:textColor="@color/accent_red"
                    android:backgroundTint="@color/key_bg_dark" />

                <TextView
                    android:id="@+id/tv_bg_image_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="No custom image loaded"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Accent Color Palette -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ACCENT COLOR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center">

                <View
                    android:id="@+id/color_blue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_category_badge"
                    android:backgroundTint="@color/accent_blue" />
                <View
                    android:id="@+id/color_purple"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_category_badge"
                    android:backgroundTint="@color/accent_purple" />
                <View
                    android:id="@+id/color_green"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_category_badge"
                    android:backgroundTint="@color/accent_green" />
                <View
                    android:id="@+id/color_orange"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_category_badge"
                    android:backgroundTint="@color/accent_orange" />
                <View
                    android:id="@+id/color_cyan"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_category_badge"
                    android:backgroundTint="#00E5FF" />
                <View
                    android:id="@+id/color_pink"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_category_badge"
                    android:backgroundTint="#FF007F" />
            </LinearLayout>

            <!-- Number Row Toggle Switch -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="LAYOUT FEATURES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_number_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:text="Always show top number row (0-9)"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_glass_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="8dp"
                android:text="Enable Frosted Glass Translucency"
                android:textColor="@color/text_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
