<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ime_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_status_card"
            android:text="@string/ime_status_checking"
            android:textColor="@color/accent_orange"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_steps"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/tv_crash_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:background="@color/crash_bg"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:visibility="gone"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_clear_crash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/clear_crash_report"
            android:textSize="12sp"
            android:backgroundTint="@color/accent_orange"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_enable_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/step1_enable"
            android:backgroundTint="@color/accent_blue" />

        <Button
            android:id="@+id/btn_select_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/step2_switch"
            android:backgroundTint="@color/accent_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/test_scratchpad"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <EditText
            android:id="@+id/edit_test_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:autofillHints="text"
            android:background="@drawable/bg_edit_text"
            android:gravity="top|start"
            android:hint="@string/edit_hint"
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preferences"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/keypress_sound"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_sound_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Sound Settings"
            android:backgroundTint="@color/accent_green"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btn_clipboard_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Clipboard History"
            android:backgroundTint="@color/accent_orange"
            style="?android:attr/buttonBarButtonStyle" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/haptic_vibration"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_popup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/key_popup_preview"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</ScrollView>
